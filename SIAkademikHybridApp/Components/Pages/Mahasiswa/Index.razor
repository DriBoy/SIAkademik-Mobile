@page "/mahasiswa"
@using SIAkademikHybridApp.Models
@using SIAkademikHybridApp.Services
@using System.Linq
@using System
@inject MahasiswaService MahasiswaService
@inject DosenService DosenService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h3 class="mt-4 mb-4">Data Mahasiswa</h3>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (!showForm)
{
    <button class="btn btn-primary mb-3"
            @onclick="ShowAddForm"
            disabled="@isSaving">
        + Tambah Mahasiswa
    </button>
}

@if (showForm)
{
    <div class="card mb-4 p-3">
        <h5>@(isEdit ? "Edit Mahasiswa" : "Tambah Mahasiswa")</h5>

        <EditForm Model="formModel" OnValidSubmit="SaveMahasiswa">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">NIM</label>
                <InputText @bind-Value="formModel.Nim"
                           class="form-control" />
                <ValidationMessage For="@(() => formModel.Nim)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Nama Mahasiswa</label>
                <InputText @bind-Value="formModel.NamaMahasiswa"
                           class="form-control" />
                <ValidationMessage For="@(() => formModel.NamaMahasiswa)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText @bind-Value="formModel.Email"
                           class="form-control" />
                <ValidationMessage For="@(() => formModel.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Angkatan</label>
                <InputNumber @bind-Value="formModel.Angkatan"
                             class="form-control" />
                <ValidationMessage For="@(() => formModel.Angkatan)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Dosen Wali</label>

                <InputSelect @bind-Value="formModel.DosenId"
                             class="form-select">
                    <option value="0">-- Pilih Dosen Wali --</option>

                    @if (listDosen != null)
                    {
                        @foreach (var d in listDosen)
                        {
                            <option value="@d.DosenId">
                                @d.NamaDosen (@d.Nidn)
                            </option>
                        }
                    }
                </InputSelect>

                @if (!string.IsNullOrEmpty(dosenValidationMessage))
                {
                    <div class="text-danger small">
                        @dosenValidationMessage
                    </div>
                }
            </div>

            @if (listDosen != null && listDosen.Count == 0)
            {
                <div class="alert alert-warning">
                    Belum ada data dosen. Tambahkan dosen terlebih dahulu.
                </div>
            }

            <button type="submit"
                    class="btn btn-primary me-2"
                    disabled="@isSaving">
                @(isSaving ? "Menyimpan..." : "Simpan")
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="ResetForm"
                    disabled="@isSaving">
                Batal
            </button>
        </EditForm>
    </div>
}

@if (isLoading)
{
    <p>Memuat data mahasiswa...</p>
}
else if (listMhs == null)
{
    <div class="alert alert-warning">
        Data mahasiswa tidak dapat dimuat.
        Periksa koneksi dan pastikan API sedang berjalan.

        <button class="btn btn-sm btn-outline-primary ms-2"
                @onclick="LoadData">
            Coba Lagi
        </button>
    </div>
}
else if (listMhs.Count == 0)
{
    <div class="alert alert-info">
        Belum ada data mahasiswa.
    </div>
}
else
{

    
    <div class="search-container">
        <span class="search-icon">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="18" height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
        </span>

        <input type="text"
               class="search-input"
               placeholder="Cari mahasiswa..."
               @bind="searchText"
               @bind:event="oninput" />

        @if (!string.IsNullOrWhiteSpace(searchText))
        {
            <button type="button"
                    class="search-clear"
                    @onclick="ResetSearch">
                Hapus
            </button>
        }
    </div>

    <style>
        .search-container {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            max-width: 420px;
            padding: 0 14px;
            margin-bottom: 20px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            box-sizing: border-box;
            transition: border-color 0.2s ease;
        }

        .search-container:focus-within {
            border-color: #9ca3af;
        }

        .search-icon {
            display: flex;
            align-items: center;
            color: #9ca3af;
        }

        .search-input {
            flex: 1;
            min-width: 0;
            padding: 12px 0;
            border: none;
            outline: none;
            background: transparent;
            font-size: 14px;
            color: #374151;
        }

        .search-input::placeholder {
            color: #9ca3af;
        }

        .search-clear {
            border: none;
            background: transparent;
            color: #6b7280;
            font-size: 13px;
            cursor: pointer;
            padding: 4px;
        }

        .search-clear:hover {
            color: #111827;
        }
    </style>


    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted">
            Total: @listMhs.Count mahasiswa
        </span>

        <button class="btn btn-outline-secondary btn-sm"
                @onclick="ResetSort">
            Reset Sort
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>
                        <button type="button"
                                class="sort-button"
                                @onclick='() => SortBy("Nim")'>
                            NIM @SortIndicator("Nim")
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="sort-button"
                                @onclick='() => SortBy("NamaMahasiswa")'>
                            Nama @SortIndicator("NamaMahasiswa")
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="sort-button"
                                @onclick='() => SortBy("Email")'>
                            Email @SortIndicator("Email")
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="sort-button"
                                @onclick='() => SortBy("Angkatan")'>
                            Angkatan @SortIndicator("Angkatan")
                        </button>
                    </th>

                    <th>
                        <button type="button"
                                class="sort-button"
                                @onclick='() => SortBy("DosenWali")'>
                            Dosen Wali @SortIndicator("DosenWali")
                        </button>
                    </th>

                    <th>Aksi</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var m in FilteredMahasiswa)
                {
                    <tr @key="m.MahasiswaId">
                        <td>@m.Nim</td>
                        <td>@m.NamaMahasiswa</td>
                        <td>@m.Email</td>
                        <td>@m.Angkatan</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(m.DosenWali)
                                ? "-"
                                : m.DosenWali)
                        </td>

                        <td class="text-nowrap">
                            <button class="btn btn-warning btn-sm me-1"
                                    @onclick="() => EditMahasiswa(m)"
                                    disabled="@isSaving"
                                    title="Edit Mahasiswa">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16" height="16"
                                     fill="currentColor"
                                     viewBox="0 0 16 16">
                                    <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708z" />
                                    <path d="M11.207 3 13 4.793 6.5 11.293V9.5h-1.5V8z" />
                                    <path d="M1 13.5A1.5 1.5 0 0 0 2.5 15H13a1 1 0 0 0 1-1V7h-1v7H2V3h6V2H2.5A1.5 1.5 0 0 0 1 3.5z" />
                                </svg>
                            </button>

                            <button class="btn btn-danger btn-sm me-1"
                                    @onclick="() => DeleteMahasiswa(m.MahasiswaId)"
                                    disabled="@isSaving"
                                    title="Hapus Mahasiswa">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16" height="16"
                                     fill="currentColor"
                                     viewBox="0 0 16 16">
                                    <path d="M2.5 1a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v1h1v1H1V2h1.5zM3 4h10l-.8 10.2a1 1 0 0 1-1 .8H4.8a1 1 0 0 1-1-.8z" />
                                </svg>
                            </button>

                            <button class="btn btn-info btn-sm"
                                    @onclick="() => DetailMhs(m.MahasiswaId)"
                                    disabled="@isSaving"
                                    title="Detail Mahasiswa">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="16" height="16"
                                     fill="currentColor"
                                     viewBox="0 0 16 16">
                                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0" />
                                    <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 4a4 4 0 1 0 0-8 4 4 0 0 0 0 8" />
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .sort-button {
        border: none;
        background: transparent;
        padding: 0;
        color: inherit;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        text-align: left;
    }

    .sort-button:hover {
        color: #2563eb;
    }
</style>

@code {
    private List<MahasiswaModel>? listMhs;
    private List<DosenModel>? listDosen;

    private MahasiswaModel formModel = new();

    private string searchText = string.Empty;

    private bool isEdit;
    private bool showForm;
    private bool isLoading;
    private bool isSaving;

    private string? successMessage;
    private string? errorMessage;
    private string? dosenValidationMessage;

    // Sorting
    private string sortColumn = "NamaMahasiswa";
    private bool sortAscending = true;

    private IEnumerable<MahasiswaModel> FilteredMahasiswa
    {
        get
        {
            if (listMhs == null)
                return Enumerable.Empty<MahasiswaModel>();

            if (string.IsNullOrWhiteSpace(searchText))
                return SortedMahasiswa;

            return SortedMahasiswa.Where(m =>
                (m.Nim ?? "").Contains(
                    searchText.Trim(),
                    StringComparison.OrdinalIgnoreCase
                )
                ||
                (m.NamaMahasiswa ?? "").Contains(
                    searchText.Trim(),
                    StringComparison.OrdinalIgnoreCase
                )
                ||
                (m.Email ?? "").Contains(
                    searchText.Trim(),
                    StringComparison.OrdinalIgnoreCase
                )
                ||
                (m.DosenWali ?? "").Contains(
                    searchText.Trim(),
                    StringComparison.OrdinalIgnoreCase
                )
            );
        }
    }

    private void ResetSearch()
    {
        searchText = string.Empty;
    }

    private IEnumerable<MahasiswaModel> SortedMahasiswa
    {
        get
        {
            var data = listMhs ?? new List<MahasiswaModel>();

            return sortColumn switch
            {
                "Nim" => sortAscending
                    ? data.OrderBy(m => m.Nim)
                    : data.OrderByDescending(m => m.Nim),

                "NamaMahasiswa" => sortAscending
                    ? data.OrderBy(m => m.NamaMahasiswa)
                    : data.OrderByDescending(m => m.NamaMahasiswa),

                "Email" => sortAscending
                    ? data.OrderBy(m => m.Email)
                    : data.OrderByDescending(m => m.Email),

                "Angkatan" => sortAscending
                    ? data.OrderBy(m => m.Angkatan)
                    : data.OrderByDescending(m => m.Angkatan),

                "DosenWali" => sortAscending
                    ? data.OrderBy(m => m.DosenWali)
                    : data.OrderByDescending(m => m.DosenWali),

                _ => data.OrderBy(m => m.NamaMahasiswa)
            };
        }
    }

    private string SortIndicator(string column)
    {
        if (sortColumn != column)
            return "↕";

        return sortAscending ? "▲" : "▼";
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private void ResetSort()
    {
        sortColumn = "NamaMahasiswa";
        sortAscending = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var mahasiswaTask = MahasiswaService.GetMahasiswasAsync();
            var dosenTask = DosenService.GetDosensAsync();

            await Task.WhenAll(mahasiswaTask, dosenTask);

            listMhs = await mahasiswaTask;
            listDosen = await dosenTask;
        }
        catch (Exception)
        {
            listMhs = null;
            listDosen = null;

            errorMessage =
                "Gagal mengambil data dari API. " +
                "Periksa koneksi dan status backend.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        formModel = new MahasiswaModel();
        isEdit = false;
        showForm = true;
        ClearMessages();
    }

    private void DetailMhs(int id)
    {
        Navigation.NavigateTo($"/mahasiswa/detail/{id}");
    }

    private async Task SaveMahasiswa()
    {
        if (isSaving)
            return;

        ClearMessages();

        if (formModel.DosenId <= 0 ||
            listDosen == null ||
            !listDosen.Any(d => d.DosenId == formModel.DosenId))
        {
            dosenValidationMessage = "Pilih dosen wali yang tersedia.";
            return;
        }

        // Cek NIM duplikat untuk tambah maupun edit.
        if (listMhs != null &&
            listMhs.Any(m =>
                string.Equals(
                    m.Nim?.Trim(),
                    formModel.Nim?.Trim(),
                    StringComparison.OrdinalIgnoreCase)
                && (!isEdit || m.MahasiswaId != formModel.MahasiswaId)))
        {
            errorMessage = "NIM sudah terdaftar dalam sistem.";
            return;
        }

        isSaving = true;

        try
        {
            if (isEdit)
            {
                await MahasiswaService.UpdateMahasiswaAsync(
                    formModel.MahasiswaId,
                    formModel);

                successMessage = "Data mahasiswa berhasil diperbarui.";
            }
            else
            {
                await MahasiswaService.CreateMahasiswaAsync(formModel);

                successMessage = "Data mahasiswa berhasil ditambahkan.";
            }

            showForm = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Gagal menyimpan: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditMahasiswa(MahasiswaModel m)
    {
        formModel = new MahasiswaModel
        {
            MahasiswaId = m.MahasiswaId,
            Nim = m.Nim,
            NamaMahasiswa = m.NamaMahasiswa,
            Email = m.Email,
            Angkatan = m.Angkatan,
            DosenId = m.DosenId
        };

        isEdit = true;
        showForm = true;
        ClearMessages();
    }

    private async Task DeleteMahasiswa(int id)
    {
        if (isSaving)
            return;

        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Apakah kamu yakin ingin menghapus mahasiswa ini?");

        if (!confirmed)
            return;

        ClearMessages();
        isSaving = true;

        try
        {
            await MahasiswaService.DeleteMahasiswaAsync(id);

            successMessage = "Data mahasiswa berhasil dihapus.";
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Gagal menghapus mahasiswa: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        formModel = new MahasiswaModel();
        isEdit = false;
        showForm = false;
        ClearMessages();
    }

    private void ClearMessages()
    {
        successMessage = null;
        errorMessage = null;
        dosenValidationMessage = null;
    }
}
